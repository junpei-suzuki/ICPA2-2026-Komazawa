N <- 50
scatter_dta <- tibble(
x        = runif(N, min = 0, max = 1),
y1       = 0.4 + 0.8 * x + rnorm(N, mean = 0, sd = 0.1),
y2       = 0.4 - 0 * x   + rnorm(N, mean = 0, sd = 0.1),
y3       = 0.8 - 0.8 * x + rnorm(N, mean = 0, sd = 0.1)
)
x_mean <- scatter_dta$x |> mean()
y1_mean <- scatter_dta$y1 |> mean()
y2_mean <- scatter_dta$y1 |> mean()
y3_mean <- scatter_dta$y1 |> mean()
scatter_dta |>
ggplot(aes(x = x, y = y1)) +
geom_point(size = 3) +
labs(title = "データ1",
x = "X",
y = "Y")
scatter_dta |>
ggplot(aes(x = x, y = y2)) +
geom_point(size = 3) +
labs(title = "データ2",
x = "X",
y = "Y")
scatter_dta |>
ggplot(aes(x = x, y = y3)) +
geom_point(size = 3) +
labs(title = "データ3",
x = "X",
y = "Y")
scatter_dta |>
ggplot(aes(x = x, y = y1)) +
geom_point(size = 3) +
geom_smooth(method = "lm", se = FALSE) +
geom_vline(xintercept = x_mean) +
geom_hline(xintercept = y1_mean) +
labs(title = "データ1",
x = "X",
y = "Y")
scatter_dta |>
ggplot(aes(x = x, y = y1)) +
geom_point(size = 3) +
geom_smooth(method = "lm", se = FALSE) +
geom_vline(xintercept = x_mean) +
geom_hline(yintercept = y1_mean) +
labs(title = "データ1",
x = "X",
y = "Y")
