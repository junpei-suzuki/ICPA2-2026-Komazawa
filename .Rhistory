stat_function(fun = ~ dnorm(.x, mean = 0, sd = 150),
xlim = c(-300, lower_bound),
geom = "area",
fill = "skyblue",
alpha = 0.5,
n = 500) +
stat_function(fun = ~ dnorm(.x, mean = 0, sd = 150),
xlim = c(upper_bound, 300),
geom = "area",
fill = "skyblue",
alpha = 0.5,
n = 500) +
stat_function(fun = dnorm,
n = 1000,
args = list(mean = 0, sd = 150)) +
geom_vline(xintercept = 220,
colour = "red",
linewidth = 1) +
annotate("text",
x = 265,
y = 0.0035,
size = 7,
label = "220",
colour = "red") +
scale_y_continuous() +
labs(title = "標準誤差が150の場合",
x = "",
y = "")
