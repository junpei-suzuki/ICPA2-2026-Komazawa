#| echo: false
load("~/Documents/ICPA2-2026-Komazawa/data/Ch2_ChapterExample_Donuts.RData")
donuts_data <- data.frame(
name = name,
male = male,
child = child,
donuts = donuts,
weight = weight / 2.205
)
donuts_data |>
saveRDS(file = "donuts.RDS")
local({
r <- getOption("repos")
r["CRAN"] <- "https://cloud.r-project.org/"
options(repos = r)
})
#| echo: false
rm(list = ls())
dta <- readRDS("donuts.RDS")
head(dta) # 上から6行目までのデータが表示される
sum(is.finite(dta$weight)) # 観察数：体重
mean(dta$weight, na.rm = TRUE) # 平均：体重
sd(dta$weight, na.rm = TRUE) # 標準偏差：体重
min(dta$weight, na.rm = TRUE) # 最小値：体重
max(dta$weight, na.rm = TRUE) # 最大値：体重
sum(is.finite(dta$donuts)) # 観察数：ドーナツ
mean(dta$donuts, na.rm = TRUE) # 平均：ドーナツ
sd(dta$donuts, na.rm = TRUE) # 標準偏差：ドーナツ
min(dta$donuts, na.rm = TRUE) # 最小値：ドーナツ
max(dta$donuts, na.rm = TRUE) # 最大値：ドーナツ
plot(dta$donuts, dta$weight)
OLSresult <- lm(weight ~ donuts, data = dta)
summary(OLSresult)
plot(dta$donuts, dta$weight)
abline(OLSresult)
plot(dta$donuts, dta$weight)
abline(OLSresult)
OLSresult
plot(dta$donuts, dta$weight)
abline(OLSresult)
plot(dta$donuts, dta$weight)
abline(OLSresult)
plot(dta$donuts, dta$weight)
abline(OLSresult)
plot(dta$donuts, dta$weight)
abline(OLSresult)
OLSresult_Male <- lm(weight ~ donuts, data = dta,
subset = (male == 1)) # ==と2回続けるのに注意
summary(OLSresult_Male)
OLSresult_Adult <- lm(weight ~ donuts, data = dta,
subset = (child == 0)) # ==と2回続けるのに注意
summary(OLSresult_Adult)
OLSresult_NoHomer <- lm(weight ~ donuts, data = dta,
subset = (name != "Homer"))
# 名前は文字列なので""は忘れない。
# また!=はノットイコールを意味する。
summary(OLSresult_NoHomer)
install.packages("AER") # これは一度だけで大丈夫
install.packages("AER") # これは一度だけで大丈夫
library(AER) # これはセッションのたびに実行
summary(OLSresult) # デフォルトの分析結果
# 頑健標準誤差を使った分析結果
coeftest(OLSresult, vcov = vcovHC(OLSresult, type = "HC1"))
