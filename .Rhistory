# Load the package(s)
theme_set(theme_bw()) # Set ggplot theme
#| include: false
NN <- 200
x1 <- runif(NN)
x2.temp <- runif(NN)
Corr1 <- 0.70
Corr2 <- -0.70
cor_dta <- tibble(x1 = x1,
x2 = 0.95 * (x1 * Corr1 + x2.temp * sqrt(1 - Corr1 ^ 2)) - 0.1,
x3 = x2.temp * 1.2,
x4 = x1 * Corr2 + x2.temp * sqrt(1 - Corr2^2) + 0.6)
cor_dta
sd(c(5, 6, 6, 8, 4, 9))
