id = 1:length(name),
name = name,
male = male,
donuts = round(donuts, digits = 0),
weight = round(weight / 2.205, digits = 1)
)
donut_dt |>
knitr::kable()
donut_dt |>
summarise(mean = mean(donuts))
count(weight)
