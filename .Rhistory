2.2/0.55
?qt
qt(0.005, df = 1000)
pt(4, df = 1000)
beta <- 2.2
se   <- 0.55
tval <- beta / se
tval
1 - pt(tval, df = 1000)
pval <- (1 - pt(tval, df = 1000)) * 2
pval
beta <- 2.2
se   <- 0.55
tval <- beta / se
pval <- (1 - pt(tval, df = 1000)) * 2
lower_bound <- qt(pval / 2, df = 1000)
upper_bound <- qt(1 - pval / 2, df = 1000)
tibble(x = c(-4.5, 4.5)) |>
ggplot(aes(x = x)) +
stat_function(fun = ~ dt(.x, df = 1000),
xlim = c(-3, lower_bound),
geom = "area",
fill = "skyblue",
alpha = 0.5,
n = 500) +
stat_function(fun = ~ dt(.x, df = 1000),
xlim = c(upper_bound, 3),
geom = "area",
fill = "skyblue",
alpha = 0.5,
n = 500) +
stat_function(fun = dt,
n = 1000,
args = list(df = 1000)) +
annotate("text",
x = lower_bound + 0.5,
y = 0.05,
label = round(lower_bound, 2),
size = 6) +
annotate("text",
x = upper_bound - 0.5,
y = 0.05,
label = round(upper_bound, 2),
size = 6) +
scale_y_continuous() +
