set.seed(19940309) # Someone's birthday
pacman::p_load(tidyverse,
ggrepel)
# Load the package(s)
theme_set(theme_bw()) # Set ggplot theme
#| include: false
N <- 15
GPA = rnorm(N, mean = 2.5, sd = 0.5)
rnorm(N, mean = 2.5, sd = 0.5)
rnorm(N, mean = 2.5, sd = 0.8)
rnorm(N, mean = 4, sd = 2)
rnorm(N, mean = 4, sd = 1.5)
rnorm(N, mean = 4, sd = 1.5)
GPA_dta <- tibble(
study = rnorm(N, mean = 4, sd = 1.5),
GPA = 1 + 0.5 * study + rnorm(N, mean = 0, sd = 0.5)
)
GPA_dta
GPA_dta <- tibble(
study = rnorm(N, mean = 4, sd = 1.5),
GPA = 1 + 0.5 * study + rnorm(N, mean = 0, sd = 0.25)
)
GPA_dta
GPA_dta <- tibble(
study = rnorm(N, mean = 4, sd = 1),
GPA = 1 + 0.5 * study + rnorm(N, mean = 0, sd = 0.25)
)
GPA_dta
GPA_dta <- tibble(
study = rnorm(N, mean = 4, sd = 1),
GPA = 0.5 + 0.5 * study + rnorm(N, mean = 0, sd = 0.25)
)
GPA_dta
GPA_dta |>
ggplot(aes(x = study, y = GPA)) +
geom_point(size = 5) +
labs(x = "勉強時間／週", y = "GPA")
GPA_dta |>
ggplot(aes(x = study, y = GPA)) +
geom_point(size = 2.5) +
labs(x = "勉強時間／週", y = "GPA")
GPA_dta |>
ggplot(aes(x = study, y = GPA)) +
geom_point(size = 2.5) +
geom_smooth(method = "lm", colour = "red") +
labs(x = "勉強時間／週", y = "GPA")
?geom_smooth
GPA_dta |>
ggplot(aes(x = study, y = GPA)) +
geom_point(size = 2.5) +
geom_smooth(method = "lm",
se = FALSE,
colour = "red") +
labs(x = "勉強時間／週", y = "GPA")
# Load the package(s)
theme_set(theme_bw(base_family = "Hiragino Sans")) # Set ggplot theme
GPA_dta |>
ggplot(aes(x = study, y = GPA)) +
geom_point(size = 2.5) +
geom_smooth(method = "lm",
se = FALSE,
colour = "red") +
labs(x = "勉強時間／週", y = "GPA")
