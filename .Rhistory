# 1以下の値が出る確率
pt(1, df = 100)
# 下位45%の範囲の上限となる値
qt(0..45, df = 100)
dta <- readRDS("donuts.RDS")
OLSresult <- lm(weight ~ donuts, data = dta)
summary(OLSresult)
tval <- 4.742 # t値
df   <- 11    # 自由度
(lower <- qt(tval, df = df))
tval <- 4.742 # t値
df   <- 11    # 自由度
(lower <- qt(tval, df = df))
(lower <- pt(tval, df = df))
(lower <- pt(-tval, df = df)) # -4.742以下が出る確率
(upper <- 1 - pt(tval, df = df))  # 4.742以上が出る確率
(pval <- lower + upper)
# このコマンドで一括でできる
2 * (1 - pt(abs(tval), df))
confint(OLSresult)
true <- 1
sd   <- 1
cval <- qnorm(0.95, mean = true, sd = sd)
cval
pnorm(cval, mean = true, sd = sd)
cval <- qnorm(0.95, mean = 0, sd = sd)
pnorm(cval, mean = true, sd = sd)
true <- c(1, 2, 3)
sd   <- 1
cval <- qnorm(0.95, mean = 0, sd = sd)
pnorm(cval, mean = true, sd = sd)
1- pnorm(cval, mean = true, sd = sd)
true <- 1:10 # 真の値
sd   <- 1 # 標準誤差
cval <- qnorm(0.95, mean = 0, sd = sd) # 片側5%水準の臨界値
1 - pnorm(cval, mean = true, sd = sd) # 検出力
qnorm(0.95, mean = 0, sd = sd)
true <- seq(0.1, 1, 5) # 真の値
sd   <- 1 # 標準誤差
cval <- qnorm(0.95, mean = 0, sd = sd) # 片側5%水準の臨界値
1 - pnorm(cval, mean = true, sd = sd) # 検出力
seq(0.1, 1, 5)
?seq
true <- seq(1, 5, by = 0.1) # 真の値
sd   <- 1 # 標準誤差
cval <- qnorm(0.95, mean = 0, sd = sd) # 片側5%水準の臨界値
1 - pnorm(cval, mean = true, sd = sd) # 検出力
true <- seq(1, 5, by = 0.1) # 真の値
sd   <- 1 # 標準誤差
cval <- qnorm(0.95, mean = 0, sd = sd) # 片側5%水準の臨界値
power <- 1 - pnorm(cval, mean = true, sd = sd) # 検出力
plot(power())
plot(true, power)
true <- seq(1, 5, by = 0.1) # 真の値
sd   <- 2 # 標準誤差
cval <- qnorm(0.95, mean = 0, sd = sd) # 片側5%水準の臨界値
power <- 1 - pnorm(cval, mean = true, sd = sd) # 検出力
plot(true, power)
true <- 5 # 真の値
sd   <- 2 # 標準誤差
cval <- qnorm(0.95, mean = 0, sd = sd) # 片側5%水準の臨界値
cval
power <- 1 - pnorm(cval, mean = true, sd = sd) # 検出力
power
