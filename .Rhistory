tval <- 4.742 # t値
df   <- 11    # 自由度
(lower <- qt(tval, df = df))
tval <- 4.742 # t値
df   <- 11    # 自由度
(lower <- qt(tval, df = df))
(lower <- pt(tval, df = df))
(lower <- pt(-tval, df = df)) # -4.742以下が出る確率
(upper <- 1 - pt(tval, df = df))  # 4.742以上が出る確率
(pval <- lower + upper)
# このコマンドで一括でできる
2 * (1 - pt(abs(tval), df))
confint(OLSresult)
